# ---- telegram (required for alerts) ------------------------------------
TELEGRAM_BOT_TOKEN=123456:AA...
TELEGRAM_CHAT_ID=123456789
# (optional) if you skip TELEGRAM_CHAT_ID, send /start to the bot to bind your chat

# ---- web (PaaS sets PORT automatically; keep the default otherwise) -----
PORT=8080

# ---- scanning -----------------------------------------------------------
# worker loops per target group (default 1 each)
CLOUD_SCANNERS=1
RESIDENTIAL_SCANNERS=1
# concurrent probes per scanner group (shared across that group's workers)
CHECK_CONCURRENCY=50
# comma list of ports to probe (20128/20130 = popular self-hosted LLM gateway ports)
#SCAN_PORTS=80,443,8000,8080,3128,8888,1080,1081,10800,11434,4000,5000,9000,20128,20130
# random IPs to probe inside every /24 block
SAMPLE_PER_24=2
# which cloud feeds to use: aws,azure,gcp,oci,hetzner,cloudflare,digitalocean,
# alibaba,tencent,vultr,linode,fastly,ovh,scaleway,upcloud,ionos,yandex,ibm
#PROVIDERS=aws,azure,gcp,oci,hetzner,cloudflare,digitalocean,alibaba,tencent,vultr,linode,fastly,ovh,scaleway,upcloud,ionos,yandex,ibm
# key sent as "Bearer <key>" to /v1 endpoints; a second probe variant always
# sends a bare "Bearer" with an empty token (catches gateways that accept any key)
LLM_TEST_API_KEY=test
# token budget for the hello completion; keep it high enough that reasoning
# models don't burn it all before answering (429 / empty-budget hits count)
LLM_MAX_TOKENS=256
# seconds
#CONNECT_TIMEOUT=2.5
#PROBE_TIMEOUT=6
#CHAT_TIMEOUT=30
#FEED_REFRESH_HOURS=6

# ---- storage -------------------------------------------------------------
#DATA_DIR=/data

# ---- self test -------------------------------------------------------------
# 1 = run the in-process mock end-to-end self test and exit 0/1
#SELFTEST=0

# ---- camouflage page -----------------------------------------------------
PAGE_TITLE=Coming soon
PAGE_CONTENT=This site is under construction and will be back shortly.
